# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=localhost

# URL Configuration
BACKEND_URL=http://localhost:3001
FRONTEND_URL=https://localhost:5173
API_BASE_URL=http://localhost:3001/api

# HTTPS Configuration (optional)
USE_HTTPS=false
HTTPS_PORT=3443

# CORS Origins (comma-separated)
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000

# MySQL Database Configuration
# IMPORTANT: Replace 'YOUR_MYSQL_PASSWORD' with your actual MySQL root password
DATABASE_URL="mysql://root:P@ssword123@localhost:3306/ticket_management"

# JWT Configuration
JWT_SECRET="ghjghghghghjghjghj"
JWT_EXPIRES_IN=24h

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=https://localhost:5173,http://localhost:5173

# Production URLs (uncomment and modify for production)
# BACKEND_URL=https://your-domain.com
# FRONTEND_URL=https://your-frontend-domain.com
# API_BASE_URL=https://your-domain.com/api
# CORS_ORIGINS=https://your-frontend-domain.com

# MySQL Connection Details (for reference)
# Format: mysql://username:password@host:port/database_name
# Common examples:
# DATABASE_URL="mysql://root:@localhost:3306/ticket_management"  (if no password)
# DATABASE_URL="mysql://root:yourpassword@localhost:3306/ticket_management"
# DATABASE_URL="mysql://ticket_user:userpassword@localhost:3306/ticket_management"